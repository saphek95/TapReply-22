    "On se tutoie ?\nComment tu t'appelles ?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First names?\nWhat's yours?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Nos tuteamos?\n¿Cómo te llamas?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duzen wir uns?\nWie heißt du?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamoci del tu.\nCome ti chiami?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos nos chamar pelo nome?\nQual é o seu?"
          }
        }
      }
    },

    "Avec « Autoriser une fois », iOS te reposera simplement la question à chaque réponse." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With “Allow Once”, iOS will simply ask again for each reply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Permitir una vez», iOS simplemente te volverá a preguntar en cada respuesta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Einmal erlauben“ fragt iOS einfach bei jeder Antwort erneut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Consenti una volta», iOS ti rifarà semplicemente la domanda a ogni risposta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com “Permitir Uma Vez”, o iOS vai simplesmente perguntar de novo a cada resposta."
          }
        }
      }
    },

            "state" : "translated",
            "value" : "Purple is my natural color. I might be a little biased."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El morado es mi color de nacimiento. Puede que no sea imparcial."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lila ist meine Geburtsfarbe. Vielleicht bin ich da etwas voreingenommen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il viola è il mio colore di nascita. Forse sono di parte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O roxo é minha cor de nascimento. Talvez eu seja suspeito."
          }
        }
      }
    },

    "Deux taps fermes au dos de l'iPhone, près de la pomme. Retire les coques épaisses si ça ne réagit pas." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei feste Taps auf die iPhone-Rückseite, nah am Apple-Logo. Dicke Hüllen abnehmen, falls keine Reaktion."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two firm taps on the back of your iPhone, near the Apple logo. Remove thick cases if it doesn't respond."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos toques firmes en la parte trasera del iPhone, cerca de la manzana. Quita las fundas gruesas si no responde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due tap decisi sul retro dell'iPhone, vicino alla mela. Rimuovi le cover spesse se non risponde."
          }

          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el único paso que no puedo hacer por ti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist der einzige Schritt, den ich nicht für dich machen kann."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

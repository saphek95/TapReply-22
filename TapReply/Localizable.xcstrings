        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como «Analizar», pero con el tono asignado al triple toque en el Studio. Úsalo en el atajo dedicado al triple toque."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie „Analysieren“, aber mit dem Ton, der im Studio dem Dreifachtippen zugewiesen ist. Für den Kurzbefehl fürs Dreifachtippen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come «Analizza», ma con il tono assegnato al triplo tocco nello Studio. Da usare nel comando rapido dedicato al triplo tocco."

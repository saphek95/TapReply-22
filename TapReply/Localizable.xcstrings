          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noche es complicado, ¿mañana mejor? Estoy libre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute Abend ist schwierig, lieber morgen? Da habe ich Zeit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stasera è complicato, domani piuttosto? Sono libero."

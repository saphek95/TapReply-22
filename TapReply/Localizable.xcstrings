        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje não vai rolar, desculpa. A gente remarca?"
          }
        }
      }
    },
    "Ce sont des réglages d'iOS, pas de l'application. Je ne peux pas les faire à ta place, mais je te montre exactement où aller." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are iOS settings, not app settings. I can't do them for you, but I'll show you exactly where to go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son ajustes de iOS, no de la app. No puedo hacerlos yo, pero te indico exactamente dónde ir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sind iOS-Einstellungen, keine App-Einstellungen. Ich kann sie nicht für dich vornehmen, aber ich zeige dir genau, wohin du musst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono impostazioni di iOS, non dell'app. Non posso farle al posto tuo, ma ti mostro esattamente dove andare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São configurações do iOS, não do app. Não posso fazer por você, mas vou mostrar exatamente onde ir."
          }
        }
      }
    },

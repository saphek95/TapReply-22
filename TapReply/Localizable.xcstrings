    "Ce geste a son propre raccourci : iOS ne dit pas à TapReply quel geste tu as fait. Puis %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This gesture has its own shortcut: iOS doesn't tell TapReply which gesture you used. Then %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este gesto tiene su propio atajo: iOS no le dice a TapReply qué gesto hiciste. Luego %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Geste hat ihren eigenen Kurzbefehl: iOS sagt TapReply nicht, welche Geste du gemacht hast. Dann %@."

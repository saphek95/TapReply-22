    "Ce soir ça va pas être possible, désolé. On remet ça ?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonight won't work, sorry. Rain check?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noche no puede ser, lo siento. ¿Lo dejamos para otro día?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute Abend geht leider nicht. Verschieben wir's?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stasera non riesco, mi dispiace. Lo rimandiamo?"
          }

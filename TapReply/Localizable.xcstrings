    "Je vais t'apprendre UN geste. Ensuite, répondre à un message ne te prendra plus qu'une seconde." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm going to teach you ONE gesture. After that, replying to a message will take you just one second."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voy a enseñarte UN gesto. Después, responder a un mensaje te llevará solo un segundo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bringe dir EINE Geste bei. Danach brauchst du für eine Antwort nur noch eine Sekunde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti insegno UN gesto. Dopo, rispondere a un messaggio ti prenderà solo un secondo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vou te ensinar UM gesto. Depois, responder uma mensagem vai levar apenas um segundo."
          }
        }
      }
    },
    "Je vis derrière ton téléphone. Quand tu m'appelles, je lis la conversation à l'écran et j'écris la réponse." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I live behind your phone. When you call me, I read the conversation on screen and write the reply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivo detrás de tu teléfono. Cuando me llamas, leo la conversación en pantalla y escribo la respuesta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich wohne hinter deinem Telefon. Wenn du mich rufst, lese ich die Unterhaltung auf dem Bildschirm und schreibe die Antwort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivo dietro il tuo telefono. Quando mi chiami, leggo la conversazione sullo schermo e scrivo la risposta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu moro atrás do seu celular. Quando você me chama, leio a conversa na tela e escrevo a resposta."
          }
        }
      }
    },

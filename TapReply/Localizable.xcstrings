    "Nous ne stockons ni le texte ni la réponse sur nos serveurs. Les fournisseurs d'IA le traitent en temps réel, sans le conserver ni l'utiliser pour entraîner leurs modèles." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We store neither the text nor the reply on our servers. AI providers process it in real time, without keeping it or using it to train their models."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No almacenamos ni el texto ni la respuesta en nuestros servidores. Los proveedores de IA lo procesan en tiempo real, sin conservarlo ni usarlo para entrenar sus modelos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir speichern weder den Text noch die Antwort auf unseren Servern. Die KI-Anbieter verarbeiten ihn in Echtzeit, ohne ihn zu speichern oder ihre Modelle damit zu trainieren."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non conserviamo né il testo né la risposta sui nostri server. I fornitori di IA lo elaborano in tempo reale, senza conservarlo né usarlo per addestrare i loro modelli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não armazenamos o texto nem a resposta em nossos servidores. Os provedores de IA o processam em tempo real, sem guardá-lo nem usá-lo para treinar seus modelos."
          }
        }
      }
    },
    "Nous ne stockons ni le texte ni la réponse sur nos serveurs. Les fournisseurs d'IA le traitent selon leurs propres règles de confidentialité." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We store neither the text nor the reply on our servers. AI providers process it under their own privacy rules."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No almacenamos ni el texto ni la respuesta en nuestros servidores. Los proveedores de IA lo tratan según sus propias normas de privacidad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir speichern weder den Text noch die Antwort auf unseren Servern. Die KI-Anbieter verarbeiten ihn nach ihren eigenen Datenschutzregeln."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non conserviamo né il testo né la risposta sui nostri server. I fornitori di IA lo trattano secondo le proprie regole sulla privacy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não armazenamos o texto nem a resposta em nossos servidores. Os provedores de IA o tratam segundo suas próprias regras de privacidade."
          }
        }
      }
    },

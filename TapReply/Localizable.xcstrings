    "Rien n'est jamais stocké" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nie etwas gespeichert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is ever stored"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada se almacena nunca"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente viene mai salvato"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada é armazenado"
          }
        }
      }
    },
    "Rien ne part sans ton geste, et c'est toi qui colles et envoies la réponse. Tu peux retirer ton accord à tout moment dans Réglages, Partage avec l'IA." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is sent without your gesture, and you're the one who pastes and sends the reply. You can withdraw your consent anytime in Settings, AI sharing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envía nada sin tu gesto, y eres tú quien pega y envía la respuesta. Puedes retirar tu consentimiento cuando quieras en Ajustes, Compartir con la IA."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne deine Geste wird nichts gesendet, und du fügst die Antwort selbst ein und schickst sie ab. Du kannst deine Zustimmung jederzeit unter Einstellungen, Teilen mit der KI widerrufen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla parte senza il tuo gesto, e sei tu a incollare e inviare la risposta. Puoi ritirare il consenso in qualsiasi momento in Impostazioni, Condivisione con l'IA."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada é enviado sem o seu gesto, e é você quem cola e envia a resposta. Você pode retirar seu consentimento a qualquer momento em Ajustes, Compartilhamento com a IA."
          }
        }
      }
    },
    "Rien ne s'envoie sans toi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing sends without you"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada se envía sin ti"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wird ohne dich gesendet"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente viene inviato senza di te"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada é enviado sem você"
          }
        }
      }
    },

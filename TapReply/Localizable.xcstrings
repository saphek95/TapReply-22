        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Entwurf bleibt im Feld, er wird nicht gesendet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua bozza resta nel campo, non parte."
          }
        },

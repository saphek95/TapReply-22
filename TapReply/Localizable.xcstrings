          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di continuare,\nil tuo consenso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de continuar,\nseu acordo."
          }

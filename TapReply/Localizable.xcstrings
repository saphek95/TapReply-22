    "40 secondes plus tard, toujours rien d'envoyé. Pas faute d'idée : tu cherches la bonne formulation." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "40 seconds later, still nothing sent. Not for lack of ideas, you're searching for the right words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "40 segundos después, sin enviar nada. No es falta de ideas: buscas la forma exacta de decirlo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "40 Sekunden später, noch nichts abgeschickt. Nicht weil du keine Idee hast – du suchst die richtige Formulierung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "40 secondi dopo, ancora nulla inviato. Non è che non sai cosa dire: stai cercando le parole giuste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "40 segundos depois, nada enviado ainda. Não é falta de ideia: é a formulação certa que não vem."
          }
        }
      }
    },

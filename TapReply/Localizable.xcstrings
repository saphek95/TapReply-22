    },
    "Tu as atteint l'usage raisonnable du jour (100 réponses). Ça repart demain." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've reached today's fair use (100 replies). It resets tomorrow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has alcanzado el uso razonable del día (100 respuestas). Se reinicia mañana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die faire Tagesnutzung erreicht (100 Antworten). Morgen geht's weiter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai raggiunto l'uso ragionevole di oggi (100 risposte). Si riparte domani."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você atingiu o uso razoável do dia (100 respostas). Recomeça amanhã."
          }
        }
      }
    },
    "Tu as coché TapReply ? iOS ne me permet pas de le vérifier tout seul." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you check TapReply? iOS doesn't let me verify it on my own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has marcado TapReply? iOS no me deja verificarlo solo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du TapReply angehakt? iOS lässt mich das nicht selbst prüfen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai selezionato TapReply? iOS non mi permette di verificarlo da solo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você marcou TapReply? O iOS não me deixa verificar sozinho."
          }
        }
      }
    },
    "Tu as déjà créé ton ton personnalisé gratuit. Passe Pro pour en créer autant que tu veux, ou modifie celui que tu as." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've already created your free custom tone. Go Pro to create as many as you like, or edit the one you have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya creaste tu tono personalizado gratis. Hazte Pro para crear todos los que quieras, o edita el que tienes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast deinen kostenlosen eigenen Ton schon erstellt. Hol dir Pro, um beliebig viele zu erstellen, oder bearbeite deinen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già creato il tuo tono personalizzato gratuito. Passa a Pro per crearne quanti ne vuoi, oppure modifica quello che hai."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já criou seu tom personalizado grátis. Assine o Pro para criar quantos quiser, ou edite o que você tem."
          }
        }
      }
    },
    "Tu as déjà un abonnement actif ✓" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast bereits ein aktives Abo ✓"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already have an active subscription ✓"
          }
        },
        "es" : {
          "stringUnit" : {

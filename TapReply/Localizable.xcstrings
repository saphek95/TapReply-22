          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AI reads your draft and turns it into a ready-to-send reply. It works in all your apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA lee tu borrador y lo convierte en una respuesta lista para enviar. Funciona en todas tus apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

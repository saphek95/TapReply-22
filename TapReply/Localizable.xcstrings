    "Bonjour ! Est-ce que le créneau de mardi 15h te convient toujours pour notre point projet ?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey! Passt dir Dienstag um 15 Uhr noch für unser Projekt-Update?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey! Does Tuesday at 3pm still work for you for our project check-in?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola! ¿Sigue bien para ti el martes a las 15h para nuestra reunión de proyecto?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao! Il martedì alle 15 ti va ancora bene per il nostro aggiornamento sul progetto?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi! A terça às 15h ainda está bom pra você para nossa reunião de projeto?"
          }
        }
      }
    },
    "Bonjour, bien sûr : je vous le transmets d'ici la fin de journée. N'hésitez pas si vous avez la moindre question." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hello, of course, I'll pass it along by end of day. Don't hesitate if you have any questions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buenos días, claro: te lo envío antes de que acabe el día. Cualquier duda, no dudes en escribir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guten Tag, natürlich – ich leite es Ihnen noch heute zu. Melden Sie sich gerne bei Fragen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buongiorno, certo: glielo trasmetto entro fine giornata. Non esiti a contattarmi per qualsiasi domanda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá, claro! Encaminharei até o final do dia. Fique à vontade para qualquer dúvida."
          }
        }
      }
    },

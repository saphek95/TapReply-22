          }
        }
      }
    },
    "Tu tapes deux fois au dos de ton téléphone. Sans rien ouvrir, sans rien copier." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You double-tap the back of your phone. Without opening anything, without copying anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocas dos veces la parte posterior de tu teléfono. Sin abrir nada, sin copiar nada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tippst zweimal auf die Rückseite deines Handys. Ohne etwas zu öffnen, ohne etwas zu kopieren."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocchi due volte il retro del telefono. Senza aprire nulla, senza copiare nulla."

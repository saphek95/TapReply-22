    "Écris tes idées ci-dessous (optionnel), puis double-tape au dos de ton iPhone, ou utilise le bouton du bas." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib deine Ideen unten (optional), dann tippe zweimal auf die iPhone-Rückseite, oder nutze den Button unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jot down your ideas below (optional), then double-tap the back of your iPhone, or use the button at the bottom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe tus ideas abajo (opcional), luego toca dos veces la parte trasera de tu iPhone, o usa el botón de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écris tes idées ci-dessous (optionnel), puis double-tape au dos de ton iPhone, ou utilise le bouton du bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi le tue idee qui sotto (opzionale), poi doppio tap sul retro del tuo iPhone, o usa il pulsante in basso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva suas ideias abaixo (opcional), depois dê um toque duplo nas costas do iPhone, ou use o botão abaixo."
          }
        }
      }
    },
    "Écris ton envie en bas (ex. « pizza »), puis double-tape." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib unten, worauf du Lust hast (z. B. „Pizza“), und doppeltippe dann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type what you want below (e.g. “pizza”), then double-tap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe lo que quieres abajo (ej. «pizza») y haz doble toque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi qui sotto cosa vuoi (es. «pizza»), poi fai doppio tocco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva o que você quer abaixo (ex. “pizza”) e dê um toque duplo."
          }
        }
      }
    },
    "Écris un message reçu : l'IA te répond avec ce ton, comme elle le fera en vrai." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write a received message, the AI replies with this tone, just like it will for real."

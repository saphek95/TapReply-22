    "Marie attend une réponse. Donne-moi juste un mot, et j'écris la phrase à ta place." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marie is waiting for a reply. Give me just one word, and I'll write the message for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "María espera respuesta. Dame una palabra y escribo la frase por ti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marie wartet auf eine Antwort. Gib mir nur ein Wort, und ich schreibe den Satz für dich."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marie aspetta una risposta. Dammi solo una parola, e scrivo la frase al posto tuo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maria está esperando uma resposta. Me dê só uma palavra, e eu escrevo a frase por você."
          }
        }
      }
    },

    "Sans abonnement, tu as droit à 1 ton personnalisé. Celui-ci est gardé, rien n'est supprimé : repasse Pro pour le retrouver, ou supprime-le." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a subscription, you get 1 custom tone. This one is kept, nothing is deleted: go Pro again to get it back, or delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin suscripción, tienes 1 tono personalizado. Este se conserva, no se borra nada: vuelve a Pro para recuperarlo, o elimínalo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Abo hast du 1 eigenen Ton. Dieser bleibt erhalten, nichts wird gelöscht: Hol dir Pro zurück, um ihn wieder zu nutzen, oder lösche ihn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza abbonamento hai diritto a 1 tono personalizzato. Questo resta salvato, non viene eliminato nulla: torna Pro per ritrovarlo, oppure eliminalo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem assinatura, você tem 1 tom personalizado. Este fica guardado, nada é apagado: volte ao Pro para recuperá-lo, ou exclua-o."
          }
        }
      }
    },

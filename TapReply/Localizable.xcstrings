    "« Autoriser une fois » et iOS te reposera la question à chaque réponse." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick “Allow Once” and iOS will ask you again for every single reply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si eliges «Permitir una vez», iOS te lo preguntará en cada respuesta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Einmal erlauben“ fragt iOS bei jeder Antwort erneut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Consenti una volta», iOS te lo richiederà a ogni risposta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com \"Permitir Uma Vez\", o iOS vai perguntar de novo em cada resposta."
          }
        }
      }
    },
    "« FAUX. La tour Eiffel mesure 330 m, pas 400. »" : {
      "localizations" : {
        "en" : {

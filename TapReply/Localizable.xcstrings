    "Trop de demandes d'affilée. Patiente quelques secondes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many requests in a row. Wait a few seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas solicitudes seguidas. Espera unos segundos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Anfragen hintereinander. Warte ein paar Sekunden."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppe richieste di fila. Aspetta qualche secondo."
          }
